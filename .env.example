PAYPAL_ENV=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
; Optional explicit payee pin. Otherwise use the payee PayPal assigns at order creation.
PAYPAL_SANDBOX_MERCHANT_ID=
; Leave empty for local checkout. Set after registering the hosted Sandbox listener.
PAYPAL_SANDBOX_WEBHOOK_ID=

; Generate a persistent, private key: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
STORELIFT_DOWNLOAD_KEY=

; Optional absolute directory outside public/. Defaults to var/ in the repo.
; STORELIFT_STATE_DIR=/absolute/private/storelift-state
; Set 1 behind a TLS-terminating reverse proxy.
STORELIFT_HTTPS=0

; Optional server-side catalog suggestions. Use your own authorized provider and model.
; Endpoints: https://openrouter.ai/api/v1/chat/completions or https://api.openai.com/v1/chat/completions
STORELIFT_AI_ENDPOINT=
STORELIFT_AI_MODEL=
STORELIFT_AI_API_KEY=
